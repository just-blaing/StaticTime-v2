<Window x:Class="statictime.bpicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="добавить в чёрный список" Height="500" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        x:Name="window">
    <Border Background="#1c1c1e" CornerRadius="10" BorderBrush="#333" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="drag_window">
                <TextBlock Text="добавить в чёрный список" Foreground="#ddd" FontSize="16" VerticalAlignment="Center"/>
                <Button Content="✕" Click="close" Background="Transparent" Foreground="#888" BorderThickness="0"
                        HorizontalAlignment="Right" Padding="5" Cursor="Hand"/>
            </Grid>

            <Button Grid.Row="1" Content="выбрать exe файл..." Click="browse_file" Margin="0,15,0,10"
                    Background="#aa55ff" Foreground="White" BorderThickness="0" Padding="10" Cursor="Hand"/>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="из запущенных ранее:" Foreground="#888" FontSize="12" Margin="0,5,0,5"/>
                <Border Grid.Row="1" Background="#11000000" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="list_known_apps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="pick_known_app" Tag="{Binding path}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            HorizontalContentAlignment="Stretch" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding icon}" Width="20" Height="20"/>
                                            <TextBlock Grid.Column="1" Text="{Binding display_name}" Foreground="#ddd"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
